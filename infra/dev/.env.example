# Copy to .env on the droplet (never commit it). Read by docker compose itself.
API_HOST=api-dev.dhunlive.com
LIVEKIT_HOST=livekit-dev.dhunlive.com

# openssl rand -hex 24 for each
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Self-hosted LiveKit. Any key name; the secret must be 32+ characters.
#   echo "API$(openssl rand -hex 6)"   and   openssl rand -hex 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
