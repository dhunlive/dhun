# Copy to dev.env on the droplet (never commit it). The backend's environment.
# Values marked FILL come from you; everything else can stay.

# staging = development behaviour on a real server: the OTP code is returned in
# the API response (MSG91 is blocked on DLT). Anyone who can reach the API can
# sign in as any number, so: testers and throwaway data only.
NODE_ENV=staging
LOG_LEVEL=info
PORT=3000
GATEWAY_PORT=3001
TRUST_PROXY=1
CORS_ORIGINS=

# Same passwords as .env. The app runs as dhun_app; migrations as the owner.
DATABASE_URL=postgres://dhun_app:FILL_APP_DB_PASSWORD@postgres:5432/dhun
MIGRATION_DATABASE_URL=postgres://dhun:FILL_POSTGRES_PASSWORD@postgres:5432/dhun
DB_POOL_MAX=10
REDIS_URL=redis://valkey:6379
RATE_LIMIT_STORE=redis
GLOBAL_RATE_LIMIT_PER_MINUTE=2000

# openssl rand -hex 32
JWT_SECRET=FILL

OTP_PROVIDER=console
EMAIL_PROVIDER=console
IAP_PROVIDER=stub
PUSH_PROVIDER=expo

# LiveKit is NOT set here: docker-compose.yml passes LIVEKIT_URL and the keys
# from .env, which the livekit service reads too. (Anything set here is ignored.)

# Optional: avatars and room covers (Cloudflare R2). Without these, uploads are off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dhun-media
R2_PUBLIC_URL=

# Optional: alerts to Telegram.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_ENV_LABEL=dev
